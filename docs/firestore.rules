rules_version = '2';
// Regras do Firestore do Grand Resort & Kitchen: cole no console do Firebase › Firestore Database › Regras › Publicar.
// saves/{uid}: progresso do jogo, só o dono lê e grava.
// ranking/{uid}: nome, dinheiro e hóspedes, todos leem; cada jogador só grava a própria linha, com campos conferidos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.save is string && request.resource.data.save.size() < 900000;
    }
    match /ranking/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['name', 'money', 'guests', 'rep', 'day', 'updated'])
                   && request.resource.data.name is string && request.resource.data.name.size() <= 20
                   && request.resource.data.money is number && request.resource.data.guests is number;
    }
  }
}
